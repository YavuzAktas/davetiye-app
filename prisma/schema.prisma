generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  plan          String       @default("free")
  password      String?
  kvkkOnay      Boolean      @default(false)
  kvkkOnayTarih DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts             Account[]
  davetiyeler          Davetiye[]
  odemeTokenlar        OdemeToken[]
  sessions             Session[]
  bildirimleri         Bildirim[]
  spotifyRefreshToken  String?
  spotifyId            String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Davetiye {
  id           String    @id @default(cuid())
  slug         String    @unique
  baslik       String
  etkinlikTur  String
  tarih        DateTime?
  mekan        String?
  mesaj        String?
  sablon       String    @default("klasik")
  muzik        String?
  aktif        Boolean   @default(true)
  goruntulenme Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String
  font         String    @default("font-sans")
  ozelRenk     String?
  kisi1        String?
  kisi2        String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  davetliler    Davetli[]
  rsvplar       RSVP[]
  albumFotolar        AlbumFoto[]
  aniDefterleri       AniDefteri[]
  masalar             Masa[]
  spotifyPlaylistId   String?
  spotifyAktif        Boolean  @default(false)
  polaroid1           String?
  polaroid2           String?
  polaroid3           String?

  @@index([userId])
  @@index([aktif])
}

model AlbumFoto {
  id         String   @id @default(cuid())
  davetiyeId String
  davetiye   Davetiye @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)
  yukleyenAd String
  dosyaUrl   String
  onaylandi  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([davetiyeId])
}

model AniDefteri {
  id         String   @id @default(cuid())
  davetiyeId String
  davetiye   Davetiye @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)
  yazarAd    String
  icerik     String   @db.Text
  onaylandi  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([davetiyeId])
}

model RSVP {
  id         String   @id @default(cuid())
  ad         String
  email      String?
  telefon    String?
  katilim    Boolean
  kisiSayisi Int      @default(1)
  mesaj          String?
  diyet          String?
  sarkiOnerisi   String?
  spotifyTrackId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  davetiyeId     String
  davetiye       Davetiye @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)
  masaAtamasi    MasaAtama?

  @@index([davetiyeId])
}

model Masa {
  id          String      @id @default(cuid())
  davetiyeId  String
  isim        String
  kapasite    Int         @default(8)
  sira        Int         @default(0)
  createdAt   DateTime    @default(now())
  davetiye    Davetiye    @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)
  atamalar    MasaAtama[]

  @@index([davetiyeId])
}

model MasaAtama {
  id        String   @id @default(cuid())
  masaId    String
  rsvpId    String   @unique
  createdAt DateTime @default(now())
  masa      Masa     @relation(fields: [masaId], references: [id], onDelete: Cascade)
  rsvp      RSVP     @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
}

model OdemeToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  planId     String
  kullanildi Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Davetli {
  id         String   @id @default(cuid())
  ad         String
  telefon    String?
  email      String?
  notlar     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  davetiyeId String
  davetiye   Davetiye @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)

  @@index([davetiyeId])
}

model Bildirim {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip          String
  baslik       String
  mesaj        String
  okundu       Boolean  @default(false)
  davetiyeSlug String?
  createdAt    DateTime @default(now())

  @@index([userId, okundu])
  @@index([userId, createdAt])
}
