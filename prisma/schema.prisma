generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String          @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  kvkkOnay         Boolean         @default(false)
  kvkkOnayTarih    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  accounts         Account[]
  davetiyeler      Davetiye[]
  odemeTokenlar    OdemeToken[]
  odemeKayitlari   OdemeKaydi[]
  siparisler       Siparis[]
  sessions         Session[]
  bildirimleri     Bildirim[]
  geciciYuklemeler GeciciYukleme[]
  referralKod      String    @unique @default(dbgenerated("gen_random_uuid()"))
  referralKredi    Int       @default(0)
  referrallar      Referral[] @relation("ReferralVeren")
  referralAlinan   Referral?  @relation("ReferralAlan")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RateLimitKaydi {
  id        String   @id @default(cuid())
  ad        String
  anahtar   String
  sayi      Int      @default(0)
  sifirAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ad, anahtar])
  @@index([sifirAt])
}

model Davetiye {
  id              String       @id @default(cuid())
  slug            String       @unique
  baslik          String
  etkinlikTur     String
  tarih           DateTime?
  mekan           String?
  mesaj           String?
  sablon          String       @default("klasik")
  muzik           String?
  aktif           Boolean      @default(true)
  goruntulenme    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  userId          String
  font            String       @default("font-sans")
  ozelRenk        String?
  kisi1           String?
  kisi2           String?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  davetliler      Davetli[]
  rsvplar         RSVP[]
  albumFotolar    AlbumFoto[]
  aniDefterleri   AniDefteri[]
  masalar         Masa[]
  polaroid1       String?
  polaroid2       String?
  polaroid3       String?
  sesliAniAktif    Boolean      @default(false)
  canliDuvarAktif  Boolean      @default(false)
  aniDefteriAktif  Boolean      @default(false)
  oturmaPlanAktif  Boolean      @default(false)
  sesliAnilar      SesliAni[]
  dressKod         String?
  dressKodRenkler  String?
  albumAktif       Boolean      @default(true)
  odemeDurumu          String       @default("ucretsiz")
  fiyatSnapshot        Json?
  hatirlatiMail30dk    Boolean      @default(false)
  hatirlatiMail24saat  Boolean      @default(false)
  siparisler      Siparis[]
  odemeTokenlar   OdemeToken[]
  odemeKayitlari  OdemeKaydi[]

  @@index([userId, aktif])
  @@index([userId, createdAt])
  @@index([userId, odemeDurumu])
  @@index([tarih])
  @@index([createdAt])
}

model SesliAni {
  id         String   @id @default(cuid())
  davetiyeId String
  davetiye   Davetiye @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)
  adSoyad    String
  dosyaUrl   String
  sure       Int
  onaylandi  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([davetiyeId])
  @@index([davetiyeId, onaylandi, createdAt])
}

model AlbumFoto {
  id         String   @id @default(cuid())
  davetiyeId String
  davetiye   Davetiye @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)
  yukleyenAd String
  dosyaUrl   String
  onaylandi  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([davetiyeId])
  @@index([davetiyeId, onaylandi, createdAt])
}

model AniDefteri {
  id         String   @id @default(cuid())
  davetiyeId String
  davetiye   Davetiye @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)
  yazarAd    String
  icerik     String   @db.Text
  onaylandi  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([davetiyeId])
  @@index([davetiyeId, onaylandi, createdAt])
}

model RSVP {
  id           String     @id @default(cuid())
  ad           String
  email        String?
  telefon      String?
  katilim      Boolean
  kisiSayisi   Int        @default(1)
  mesaj        String?
  diyet        String?
  sarkiOnerisi String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  davetiyeId   String
  davetiye     Davetiye   @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)
  masaAtamasi  MasaAtama?

  @@index([davetiyeId, createdAt])
  @@index([davetiyeId, katilim, createdAt])
  @@index([davetiyeId, ad, createdAt])
}

model Masa {
  id         String      @id @default(cuid())
  davetiyeId String
  isim       String
  kapasite   Int         @default(8)
  sira       Int         @default(0)
  createdAt  DateTime    @default(now())
  davetiye   Davetiye    @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)
  atamalar   MasaAtama[]

  @@index([davetiyeId, sira])
}

model MasaAtama {
  id        String   @id @default(cuid())
  masaId    String
  rsvpId    String   @unique
  createdAt DateTime @default(now())
  masa      Masa     @relation(fields: [masaId], references: [id], onDelete: Cascade)
  rsvp      RSVP     @relation(fields: [rsvpId], references: [id], onDelete: Cascade)

  @@index([masaId])
}

model OdemeToken {
  id                 String    @id @default(cuid())
  token              String    @unique
  userId             String
  planId             String
  urunTipi           String    @default("plan")
  davetiyeId         String?
  siparisId          String?
  toplamTutar        Int?
  fiyatKirilimi      Json?
  kullanildi         Boolean   @default(false)
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  aliciAdSoyad       String?
  aliciTelefon       String?
  aliciKimlikVergiNo String?
  aliciSehir         String?
  aliciAdres         String?
  referralIndirimi   Int       @default(0)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  davetiye           Davetiye? @relation(fields: [davetiyeId], references: [id], onDelete: SetNull)
  siparis            Siparis?  @relation(fields: [siparisId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([davetiyeId])
  @@index([siparisId])
  @@index([expiresAt])
}

model OdemeKaydi {
  id                 String    @id @default(cuid())
  userId             String?
  userEmail          String?
  planId             String
  urunTipi           String    @default("plan")
  davetiyeId         String?
  siparisId          String?
  fiyatKirilimi      Json?
  token              String?   @unique
  paymentId          String?
  conversationId     String?
  price              String?
  paidPrice          String?
  currency           String    @default("TRY")
  paymentStatus      String?
  aliciAdSoyad       String?
  aliciTelefon       String?
  aliciKimlikVergiNo String?
  aliciSehir         String?
  aliciAdres         String?
  createdAt          DateTime  @default(now())
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  davetiye           Davetiye? @relation(fields: [davetiyeId], references: [id], onDelete: SetNull)
  siparis            Siparis?  @relation(fields: [siparisId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([davetiyeId])
  @@index([siparisId])
  @@index([createdAt])
}

model Siparis {
  id             String       @id @default(cuid())
  userId         String
  davetiyeId     String?
  durum          String       @default("odeme_bekliyor")
  urunTipi       String       @default("davetiye")
  paraBirimi     String       @default("TRY")
  araToplam      Int
  toplamTutar    Int
  fiyatKirilimi  Json
  odemeToken     String?      @unique
  paymentId      String?
  conversationId String?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  davetiye       Davetiye?    @relation(fields: [davetiyeId], references: [id], onDelete: SetNull)
  odemeTokenlar  OdemeToken[]
  odemeKayitlari OdemeKaydi[]

  @@index([userId, durum])
  @@index([davetiyeId])
  @@index([createdAt])
}

model GeciciYukleme {
  id         String    @id @default(cuid())
  userId     String
  dosyaUrl   String    @unique
  tip        String    @default("polaroid")
  kullanildi Boolean   @default(false)
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kullanildi, createdAt])
}

model MedyaSilmeKuyrugu {
  id            String    @id @default(cuid())
  dosyaUrl      String    @unique
  kaynak        String
  denemeSayisi  Int       @default(0)
  sonHata       String?
  sonrakiDeneme DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([sonrakiDeneme, createdAt])
  @@index([createdAt])
}

model ImhaKaydi {
  id             String   @id @default(cuid())
  kaynak         String
  islemTuru      String
  veriKategorisi String
  adet           Int
  yontem         String
  gerekce        String
  detay          Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([kaynak])
}

model YasalOnayKaydi {
  id             String    @id @default(cuid())
  userId         String?
  emailHash      String?
  onayTipi       String
  metinSurumu    String
  kaynak         String
  hesapSilindiAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([emailHash])
  @@index([hesapSilindiAt])
  @@index([createdAt])
}

model Davetli {
  id         String   @id @default(cuid())
  ad         String
  telefon    String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  davetiyeId String
  davetiye   Davetiye @relation(fields: [davetiyeId], references: [id], onDelete: Cascade)

  @@index([davetiyeId, createdAt])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  odendi     Boolean  @default(false)
  tutar      Int      @default(50)
  createdAt  DateTime @default(now())
  referrer   User     @relation("ReferralVeren", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   User     @relation("ReferralAlan",  fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model Bildirim {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip          String
  baslik       String
  mesaj        String
  okundu       Boolean  @default(false)
  davetiyeSlug String?
  createdAt    DateTime @default(now())

  @@index([userId, okundu])
  @@index([userId, createdAt])
}
